{
  "name": "world-beat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:content": "node tools/e2e/content.cjs",
    "verify:e2e": "node tools/e2e/runner.cjs flow timing layout",
    "verify": "npm run typecheck && npm run build && node tools/e2e/runner.cjs --no-build"
  },
  "devDependencies": {
    "puppeteer": "^24.43.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "flag-icons": "^7.5.0"
  }
}
